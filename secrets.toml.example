# Copy these into Streamlit Community Cloud -> App settings -> Secrets
# (for local runs, copy this file to .streamlit/secrets.toml and fill in the key)

GEMINI_API_KEY = "paste-your-google-ai-studio-key-here"

# Optional
GEMINI_MODEL   = "gemini-3.5-flash-lite"   # 500 free requests/day; "gemini-3.8-flash" is smarter but ~20/day
SERPER_API_KEY = ""                        # optional: better web-search coverage than the free DuckDuckGo backend
